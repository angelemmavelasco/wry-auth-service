# project environment
DEBUG=true


# conn to postgres
DB_HOST=localhost

# change this to 5433 / 5434 ... in case the port 5432 is already in use
DB_PORT=5432

# configure your own data
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=ultraSecurePassword123

#in case you want it, you can place this variable only and the database is gonna work, but we strongly recommend you to declare all variables presented here.
CONN_STRING=postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable